PROJECT_NAME=FasoData
ENVIRONMENT=production

# Public domains used by Nginx and Let's Encrypt.
APP_DOMAIN=fasodata.bf
DEVELOPERS_DOMAIN=developers.fasodata.bf
LETSENCRYPT_EMAIL=admin@fasodata.bf
LETSENCRYPT_STAGING=false

# Public browser/API URLs.
NEXT_PUBLIC_API_URL=https://fasodata.bf/api
NEXT_PUBLIC_APP_NAME=FasoData
CORS_ORIGINS=https://fasodata.bf,https://developers.fasodata.bf
APP_BASE_URL=https://fasodata.bf

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fasodata
POSTGRES_USER=fasodata
POSTGRES_PASSWORD=change_me_db_password
DATABASE_URL=postgresql+asyncpg://fasodata:change_me_db_password@db:5432/fasodata

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=fasodata
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=fasodata-uploads
MINIO_SECURE=false

# Meilisearch
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=change_me_meili_key

# Auth JWT
SECRET_KEY=change_me_very_long_random_secret_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin
FIRST_ADMIN_EMAIL=admin@fasodata.bf
FIRST_ADMIN_PASSWORD=change_me_admin_password

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@fasodata.bf

# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SHORTCODE=
AT_SANDBOX=False

# WFP DataBridges - prix alimentaires Burkina Faso
WFP_API_BASE_URL=https://gateway.api.wfp.org/vam-data-bridges/v2
WFP_TOKEN_URL=https://api.wfp.org/token
WFP_API_CLIENT_ID=
WFP_API_CLIENT_SECRET=
WFP_COUNTRY_CODE=BFA
WFP_PRICES_LOOKBACK_DAYS=45
WFP_PRICES_PAGE_SIZE=1000
WFP_PRICES_TIMEOUT_SECONDS=30

# WhatsApp Cloud API - alertes prix
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENABLED=True
