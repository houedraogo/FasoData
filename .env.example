# ─── Base ────────────────────────────────────────────────────────────────────
PROJECT_NAME=FasoData
ENVIRONMENT=development   # development | production

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=fasodata
POSTGRES_USER=fasodata
POSTGRES_PASSWORD=changeme_db

DATABASE_URL=postgresql+asyncpg://fasodata:changeme_db@db:5432/fasodata

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── MinIO (stockage S3-compatible) ──────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=fasodata
MINIO_SECRET_KEY=changeme_minio
MINIO_BUCKET=fasodata-uploads
MINIO_SECURE=false

# ─── Meilisearch ─────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=changeme_meili

# ─── Auth JWT ────────────────────────────────────────────────────────────────
SECRET_KEY=changeme_secret_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:3000
APP_BASE_URL=http://localhost

# ─── Email (optionnel) ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM=noreply@fasodata.bf

# ─── Admin par défaut ────────────────────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@fasodata.bf
FIRST_ADMIN_PASSWORD=changeme_admin

# ─── Africa's Talking — Collecte SMS prix terrain ────────────────────────────
# Sandbox gratuit : https://account.africastalking.com → Sandbox → SMS
# Webhook à déclarer dans AT Dashboard → Incoming Messages → Callback URL
# URL webhook : https://votre-domaine.bf/api/prices/sms/at-callback
# Format SMS   : SORGHO SAHEL 285  (PRODUIT REGION PRIX)
AT_USERNAME=sandbox                    # "sandbox" pour les tests, votre username AT en prod
AT_API_KEY=                            # Clé API sandbox (depuis portail AT)
AT_SHORTCODE=                          # Numéro d'envoi (optionnel sandbox)
AT_SANDBOX=True                        # True=sandbox (simulation), False=production

# WFP DataBridges - prix alimentaires Burkina Faso
WFP_API_BASE_URL=https://gateway.api.wfp.org/vam-data-bridges/v2
WFP_TOKEN_URL=https://api.wfp.org/token
WFP_API_CLIENT_ID=
WFP_API_CLIENT_SECRET=
WFP_COUNTRY_CODE=BFA
WFP_PRICES_LOOKBACK_DAYS=45
WFP_PRICES_PAGE_SIZE=1000
WFP_PRICES_TIMEOUT_SECONDS=30
WFP_PUBLIC_PRICES_URL=https://data.humdata.org/dataset/bfd82e1f-0296-48a8-ac28-c11e028be5ed/resource/0eca67d6-e297-4f5e-9132-7dc42891b749/download/wfp_food_prices_bfa.csv

# WhatsApp Cloud API - alertes prix
WHATSAPP_GRAPH_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENABLED=True

# ─── Next.js public ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_APP_NAME=FasoData
