# Optional Playwright E2E configuration.
# Local development can use seeded dev credentials automatically when
# PLAYWRIGHT_BASE_URL is http://localhost. In CI/VPS, set explicit values.

PLAYWRIGHT_BASE_URL=http://localhost
PLAYWRIGHT_WORKERS=1
PLAYWRIGHT_VIDEO=0

E2E_ADMIN_EMAIL=admin@fasodata.bf
E2E_ADMIN_PASSWORD=changeme_admin

E2E_INSTITUTION_EMAIL=demo@ong.bf
E2E_INSTITUTION_PASSWORD=demo1234

# Set to 0 to force tests to skip private dashboard/admin flows unless
# explicit E2E_* variables are provided by the environment.
PLAYWRIGHT_USE_DEV_CREDENTIALS=1
